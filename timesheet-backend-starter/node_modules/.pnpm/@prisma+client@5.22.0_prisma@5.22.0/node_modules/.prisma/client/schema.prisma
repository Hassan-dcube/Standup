generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  PROGRAMME_MANAGER
  ADMIN
}

enum SessionState {
  DRAFT
  SUBMITTED
  MISSED
}

model Organization {
  id         String            @id @default(cuid())
  name       String
  timezone   String            @default("Asia/Karachi")
  users      User[]
  teams      Team[]
  templates  StandupTemplate[]
  schedules  Schedule[]
  sessions   StandupSession[]
  activities ActivityLog[]
  projects   Project[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model Team {
  id        String       @id @default(cuid())
  orgId     String
  name      String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users     UserTeam[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model User {
  id                 String           @id @default(cuid())
  orgId              String
  email              String           @unique
  name               String
  role               Role             @default(EMPLOYEE)
  org                Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teams              UserTeam[]
  sessions           StandupSession[]
  activities         ActivityLog[]    @relation("UserActivities")
  managerComments    ManagerComment[] @relation("ManagerComments")
  standupSeen        StandupSeen[]    @relation("StandupSeen")
  ownedProjects      Project[]        @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  taskAssignments    TaskAssignee[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model UserTeam {
  userId String
  teamId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
}

model StandupTemplate {
  id        String       @id @default(cuid())
  orgId     String
  name      String
  questions Json
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Schedule {
  id        String       @id @default(cuid())
  orgId     String
  window    Json
  timezone  String       @default("Asia/Karachi")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model StandupSession {
  id          String       @id @default(cuid())
  orgId       String
  userId      String
  projectId   String?
  date        DateTime
  state       SessionState @default(DRAFT)
  startedAt   DateTime?
  submittedAt DateTime?
  durationSec Int?

  org             Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  responses       StandupResponse[]
  meeting         Meeting?
  managerComments ManagerComment[]
  standupSeen     StandupSeen[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([orgId, userId, date])
}

model StandupResponse {
  id              String           @id @default(cuid())
  sessionId       String
  questionId      String
  answerText      String
  tokens          Int?
  session         StandupSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  managerComments ManagerComment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([sessionId, questionId], name: "sessionId_questionId")
  @@index([sessionId])
}

model Meeting {
  id           String         @id @default(cuid())
  sessionId    String         @unique
  platform     String
  externalId   String?
  joinUrl      String?
  startAt      DateTime?
  endAt        DateTime?
  recordingUrl String?
  session      StandupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ActivityLog {
  id        String       @id @default(cuid())
  orgId     String
  actorId   String?
  action    String
  meta      Json?
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor     User?        @relation("UserActivities", fields: [actorId], references: [id])

  @@index([orgId, createdAt])
}

model ManagerComment {
  id         String   @id @default(cuid())
  sessionId  String
  responseId String? // Optional - for comments on specific responses
  managerId  String
  comment    String
  parentId   String? // For threaded conversations
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session  StandupSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  response StandupResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  manager  User             @relation("ManagerComments", fields: [managerId], references: [id], onDelete: Cascade)
  parent   ManagerComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ManagerComment[] @relation("CommentReplies")

  @@index([sessionId])
  @@index([responseId])
  @@index([managerId])
  @@index([parentId])
}

model StandupSeen {
  id        String   @id @default(cuid())
  sessionId String
  managerId String
  seenAt    DateTime @default(now())

  session StandupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  manager User           @relation("StandupSeen", fields: [managerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, managerId])
  @@index([sessionId])
  @@index([managerId])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  DOING
  BLOCKED
  DONE
}

enum ProjectMemberRole {
  MANAGER
  STUDENT
  CONTRIBUTOR
}

enum TaskProgressSource {
  LLM
  MANUAL
}

model Project {
  id             String        @id @default(cuid())
  orgId          String
  name           String
  description    String?
  status         ProjectStatus @default(PLANNING)
  ownerId        String
  startDate      DateTime?
  endDate        DateTime?
  progressCached Float? // 0..1 progress percentage

  // Project Settings
  lookbackDays     Int     @default(7) // Days to look back for standup data
  weighting        String  @default("points") // "points" or "equal"
  smoothing        String  @default("med") // "low", "med", "high"
  dailyJumpCap     Float   @default(0.15) // Max daily progress jump (0-1)
  ragTopK          Int     @default(15) // Number of RAG snippets to retrieve
  triggersOnSubmit Boolean @default(true) // Trigger assessment on standup submit
  triggersNightly  Boolean @default(true) // Trigger nightly batch processing

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org             Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner           User             @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         ProjectMember[]
  sprints         Sprint[]
  tasks           Task[]
  standupSessions StandupSession[]

  @@index([orgId])
  @@index([ownerId])
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(CONTRIBUTOR)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Sprint {
  id        String   @id @default(cuid())
  projectId String
  name      String
  goal      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, startDate])
  @@index([projectId, endDate])
}

model Task {
  id                 String     @id @default(cuid())
  projectId          String
  sprintId           String?
  title              String
  description        String?
  status             TaskStatus @default(TODO)
  estimatePoints     Int? // Story points or effort estimation
  dueDate            DateTime?
  acceptanceCriteria String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint    Sprint?        @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assignees TaskAssignee[]
  progress  TaskProgress[]

  @@index([projectId, status])
  @@index([sprintId])
}

model TaskAssignee {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model TaskProgress {
  id         String             @id @default(cuid())
  taskId     String
  source     TaskProgressSource @default(MANUAL)
  percent    Float // 0..1 progress percentage
  status     TaskStatus? // Task status (TODO|DOING|BLOCKED|DONE)
  confidence Float? // 0..1 confidence level (for LLM sources)
  summary    String? // Short summary of progress
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([createdAt])
}
